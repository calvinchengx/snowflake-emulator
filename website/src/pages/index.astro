.note{background:var(--accent-soft);border-radius:var(--radius);padding:18px 20px;margin:0 0 16px}
/* The cross-site footer, generated by scripts/render_footer.py from the
   registry. Eleven sites each linking the other ten is 110 links; none is typed. */
.family{border-top:1px solid var(--line);margin-top:34px;padding-top:32px}
.family-lede{color:var(--muted);font-size:.95rem;max-width:68ch;margin:0 0 26px}
