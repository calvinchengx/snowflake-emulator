.pills{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:26px}
.pill{font-size:.8rem;padding:4px 11px;border-radius:999px;border:1px solid var(--line);color:var(--muted)}
.pill.now{background:var(--accent-soft);color:var(--accent);border-color:transparent;font-weight:600}
.cta{display:flex;flex-wrap:wrap;gap:12px}
