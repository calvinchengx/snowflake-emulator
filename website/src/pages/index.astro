.family-group ul{list-style:none;margin:0;padding:0;display:grid;
  grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:2px}
.family-group li{margin:0}
.family-group a,.family-group li.here{display:flex;flex-direction:column;gap:2px;
  padding:9px 12px;border-radius:9px;text-decoration:none;border:1px solid transparent}
.family-group a:hover{background:var(--panel);border-color:var(--line)}
.family-group .name{font-family:var(--mono);font-size:.86rem;font-weight:600;color:var(--accent)}
.family-group li.here .name{color:var(--ink)}
.family-group .what{font-size:.83rem;color:var(--muted);line-height:1.4}
.family-group li.here{background:var(--panel);border-color:var(--line)}
