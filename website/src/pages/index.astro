footer{border-top:1px solid var(--line);margin-top:20px;padding:26px 0 60px;color:var(--muted);font-size:.9rem}
footer a{color:var(--muted)}
.chapters{list-style:none;padding:0;display:grid;gap:10px;grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}
.chapters a{display:block;padding:12px 14px;border:1px solid var(--line,#e3e5e9);border-radius:10px;text-decoration:none}
.chapters b{display:block}
</style>
